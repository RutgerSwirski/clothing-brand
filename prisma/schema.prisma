generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
}

model Piece {
  id       Int           @id @default(autoincrement())
  title    String
  slug     String        @unique
  subtitle String?
  summary  String?
  body     String?
  status   PublishStatus @default(PUBLISHED)
  featured Boolean       @default(false)

  // Featured media (optional)
  heroId Int?        @unique
  hero   MediaAsset? @relation("HeroMedia", fields: [heroId], references: [id])

  // Editorial metadata
  season              String?
  year                Int?
  materials           String?
  sustainabilityNotes String?

  // Relations
  media      MediaAsset[]     @relation("PieceMedia")
  tags       PieceTag[]
  techniques PieceTechnique[]
  fragments  Fragment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sortOrder Int      @default(0)
}

model MediaAsset {
  id      Int    @id @default(autoincrement())
  // Backref to Piece for gallery images
  pieceId Int?
  piece   Piece? @relation("PieceMedia", fields: [pieceId], references: [id], onDelete: SetNull)

  // Backref for hero
  heroOf Piece? @relation("HeroMedia")

  type    MediaType @default(IMAGE)
  url     String
  width   Int?
  height  Int?
  alt     String?
  caption String?
  order   Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tags (e.g., denim, outerwear, upcycled)
model Tag {
  id     Int        @id @default(autoincrement())
  name   String     @unique
  slug   String     @unique
  pieces PieceTag[]
}

// Techniques (e.g., CLO3D, Projector cutting, Patchwork)
model Technique {
  id     Int              @id @default(autoincrement())
  name   String           @unique
  slug   String           @unique
  pieces PieceTechnique[]
}

model PieceTag {
  pieceId Int
  tagId   Int
  piece   Piece @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  tag     Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([pieceId, tagId])
}

model PieceTechnique {
  pieceId     Int
  techniqueId Int
  piece       Piece     @relation(fields: [pieceId], references: [id], onDelete: Cascade)
  technique   Technique @relation(fields: [techniqueId], references: [id], onDelete: Cascade)

  @@id([pieceId, techniqueId])
}

// Process timeline entries (“Fragments”)
model Fragment {
  id        Int      @id @default(autoincrement())
  pieceId   Int?
  piece     Piece?   @relation(fields: [pieceId], references: [id], onDelete: SetNull)
  title     String
  note      String?
  mediaUrl  String?
  tag       String?
  createdAt DateTime @default(now())
  order     Int      @default(0)

  @@index([pieceId, order])
}

// Keep these — still valuable without a shop
model UpcycleEnquiry {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  path      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsletterSubscription {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
}
